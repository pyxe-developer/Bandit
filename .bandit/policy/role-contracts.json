{
  "contract_version": 1,
  "policy_id": "role-contracts",
  "authority_boundary": {
    "manifests_are_append_only_evidence": true,
    "projections_are_derived_non_canonical": true,
    "manifests_can_satisfy_coordination_history": false,
    "manifests_can_satisfy_review_or_landing_evidence": false
  },
  "roles": [
    {
      "role_id": "repo_pm",
      "version": "1.0.0",
      "authority_boundary": "repo_pm may write only its declared stage evidence and cannot replace canonical workflow history.",
      "allowed_stages": [
        "stage1_brief",
        "formation_review"
      ],
      "required_inputs": [
        "approved_brief",
        "current_context",
        "stage_rubric",
        "role_run_manifest"
      ],
      "allowed_tools_or_command_families": [
        "node",
        "npm",
        "bandit"
      ],
      "allowed_write_surface_families": [
        "docs/specs/**",
        "docs/work/**/brief.md",
        "docs/work/**/formation-review.md",
        "docs/work/**/coordination-log.jsonl",
        "docs/roadmap/**",
        "STATUS.md",
        ".bandit/bootstrap-gaps.json"
      ],
      "forbidden_actions": [
        "merge",
        "push",
        "deploy",
        "edit_installed_global_skill"
      ],
      "required_output_summary": "docs/work/<ID>/repo_pm-summary.md",
      "validation_commands": [
        "npm run bandit -- validate",
        "git diff --check"
      ],
      "escalation_paths": [
        "codex_pm",
        "operator_owned_input"
      ],
      "rollback_or_supersession_rule": "Supersede with a newer versioned contract and keep prior run manifests append-only.",
      "owner": "codex_pm"
    },
    {
      "role_id": "work_item_pm",
      "version": "1.0.0",
